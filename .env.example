# Copia este fichero como .env y rellena tu clave. .env está en .gitignore: nunca se sube a Git.

# Proveedor del asistente de estudio: gemini (gratuito, por defecto) o anthropic
CHAT_PROVIDER=gemini

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Solo si usas CHAT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Opcional: modelo (por defecto gemini-3.8-flash; con más cuota gratuita: gemini-3.5-flash-lite)
# CHAT_MODEL=gemini-3.8-flash

# Para usar el chat desde la web publicada, añade su origen (sustituye <usuario>):
# CHAT_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://toniferr.github.io
